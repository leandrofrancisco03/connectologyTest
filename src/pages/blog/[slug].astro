---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { render, type CollectionEntry } from 'astro:content';
import { publishedPosts } from '../../lib/posts';
import { absoluteUrl, formatDate } from '../../lib/site';
import { services } from '../../data/services';
export async function getStaticPaths() { return (await publishedPosts()).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const canonical = absoluteUrl(`/blog/${entry.id}`);
const related = (await publishedPosts()).filter(post => post.id !== entry.id).sort((a, b) => Number(entry.data.relatedPosts?.includes(b.id) || b.data.category === entry.data.category) - Number(entry.data.relatedPosts?.includes(a.id) || a.data.category === entry.data.category)).slice(0, 3);
const minutes = Math.max(1, Math.ceil((entry.body || '').split(/\s+/).length / 200));
const schema = { '@type': 'BlogPosting', '@id': canonical + '#article', headline: entry.data.title, description: entry.data.description, image: absoluteUrl(entry.data.image || '/og/connectologyia.png'), datePublished: entry.data.datePublished.toISOString(), dateModified: (entry.data.dateModified || entry.data.datePublished).toISOString(), author: { '@type': 'Organization', name: entry.data.author, url: absoluteUrl('/sobre-nosotros'), '@id': absoluteUrl('/#organization') }, publisher: { '@id': absoluteUrl('/#organization') }, mainEntityOfPage: { '@id': canonical + '#webpage' }, inLanguage: 'es-PE', articleSection: entry.data.category };
---
<Layout title={entry.data.seoTitle || `${entry.data.title} | ConnectologyIA`} description={entry.data.description} canonical={canonical} ogType="article" ogImage={entry.data.image} schema={schema} breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Blog', url: '/blog' }, { name: entry.data.title, url: `/blog/${entry.id}` }]}>
  <Fragment slot="head"><meta property="article:published_time" content={entry.data.datePublished.toISOString()} /><meta property="article:modified_time" content={(entry.data.dateModified || entry.data.datePublished).toISOString()} /></Fragment>
  <main id="main-content" class="page-main shell">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/blog">Blog</a><span>/</span><span aria-current="page">{entry.data.category}</span></nav>
    <article>
      <header class="article-heading"><span class="eyebrow">{entry.data.category} · {minutes} min de lectura</span><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p><div class="article-byline"><a href="/sobre-nosotros">{entry.data.author}</a><span>Publicado: <time datetime={entry.data.datePublished.toISOString()}>{formatDate(entry.data.datePublished)}</time></span>{entry.data.dateModified && <span>Actualizado: <time datetime={entry.data.dateModified.toISOString()}>{formatDate(entry.data.dateModified)}</time></span>}</div></header>
      <div class="article-grid">
        <aside class="toc"><nav aria-label="Índice del artículo"><strong>En esta guía</strong><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav><a class="text-link" href="/recursos/calculadora-ahorro-automatizacion">Estima tu ahorro ↗</a></aside>
        <div class="article-body prose"><Content /><aside class="editor-note"><strong>Sobre esta guía</strong><p>Contenido editorial de ConnectologyIA. Los ejemplos ilustran decisiones de implementación; no representan resultados de clientes. Consulta las fuentes enlazadas para revisar condiciones y documentación actualizadas.</p></aside></div>
      </div>
    </article>
    <aside class="callout"><span class="eyebrow">De la idea al proceso</span><h2>¿Cómo se aplicaría a tu empresa?</h2><p>Cuéntanos qué tareas se repiten, qué herramientas usas y qué resultado quieres conseguir.</p><a class="button" href="/contacto">Solicitar evaluación gratuita ↗</a><div class="topic-links">{(entry.data.relatedServices || []).map(service => <a href={`/servicios/${service}`}>{services.find(item => item.slug === service)?.label || service.replaceAll('-', ' ')}</a>)}</div></aside>
    <section class="section"><h2 class="section-title">Sigue conectando ideas</h2><div class="cards-grid">{related.map(post => <PostCard post={post} />)}</div></section>
  </main>
</Layout>
