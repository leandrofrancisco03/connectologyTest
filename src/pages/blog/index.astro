---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts } from '../../lib/posts';
import { absoluteUrl } from '../../lib/site';
const posts = await publishedPosts();
const categories = [...new Set(posts.map(post => post.data.category))];
const schema = { '@type': 'CollectionPage', '@id': absoluteUrl('/blog#collection'), name: 'Guías de automatización e IA', url: absoluteUrl('/blog'), mainEntity: { '@type': 'ItemList', itemListElement: posts.map((post, i) => ({ '@type': 'ListItem', position: i + 1, url: absoluteUrl(`/blog/${post.id}`), name: post.data.title })) } };
---
<Layout title="Blog de automatización, n8n e IA para empresas | ConnectologyIA" description="Guías prácticas para automatizar procesos, comparar n8n, Make y Zapier, integrar tu CRM y diseñar agentes de IA con control humano." schema={schema} breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Blog', url: '/blog' }]}>
  <main id="main-content" class="page-main shell">
    <header class="page-heading"><span class="eyebrow">El conocimiento también se conecta</span><h1>Menos ruido.<br /><span class="gradient-text">Más criterio para automatizar.</span></h1><p>Guías, ejemplos y decisiones técnicas explicadas para quienes hacen crecer un negocio. Empieza por el proceso que necesitas mejorar.</p></header>
    <nav class="topic-links" aria-label="Temas del blog">{categories.map((category, i) => <a href={`#tema-${i}`}>{category}</a>)}<a href="/recursos/calculadora-ahorro-automatizacion">Calcular ahorro ↗</a></nav>
    {categories.map((category, i) => <section class="blog-category" id={`tema-${i}`}><h2 class="section-title">{category}</h2><div class="cards-grid">{posts.filter(post => post.data.category === category).map(post => <PostCard post={post} />)}</div></section>)}
    <aside class="callout"><h2>¿Buscas una solución para tu empresa?</h2><p>Conecta estas ideas con un proceso real y una métrica que puedas medir.</p><a class="button" href="/servicios">Explorar servicios ↗</a></aside>
  </main>
</Layout>
